<?xml version="1.0" encoding="utf-8"?>
<sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron" queryBinding="exslt"><sch:ns uri="http://exslt.org/dynamic" prefix="dyn"/><sch:ns uri="http://councharles.com/firstYang" prefix="fyy"/><sch:ns uri="urn:ietf:params:xml:ns:netconf:base:1.0" prefix="nc"/><sch:let name="root" value="/nc:data"/><sch:pattern id="firstYang"><sch:rule context="/nc:data/fyy:switch/fyy:interface"><sch:report test="preceding-sibling::fyy:interface[fyy:name=current()/fyy:name]">Duplicate key "fyy:name"</sch:report><sch:report test="not(fyy:mode='access') and (fyy:access-vlan[not(processing-instruction('dsrl'))] or false())">Found nodes that are valid only when "fyy:mode='access'"</sch:report><sch:report test="not(fyy:mode='trunk') and (fyy:trunked-vlans[not(processing-instruction('dsrl'))] or false())">Found nodes that are valid only when "fyy:mode='trunk'"</sch:report></sch:rule><sch:rule context="/nc:data/fyy:switch/fyy:interface/fyy:trunked-vlans"><sch:report test=". = preceding-sibling::fyy:trunked-vlans">Duplicate leaf-list entry "<sch:value-of select="."/>".</sch:report></sch:rule></sch:pattern></sch:schema>
